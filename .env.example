NEXT_PUBLIC_SITE_URL=

# DeepSeek — OPTIONAL semantic intent parser + selected-destination source synthesis.
# It never chooses destinations or invents travel facts.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

# OpenAI — OPTIONAL cheap consistency verifier only when ranking is ambiguous.
# It is skipped for clear ranking sets.
OPENAI_API_KEY=
OPENAI_VERIFY_MODEL=gpt-5.4-nano

# Weather evidence:
# Long-range: NASA POWER climatology, no LLM/token cost.
# Optional commercial Open-Meteo key: short-range forecast within supported horizon.
OPEN_METEO_API_KEY=

# Supabase Destination Knowledge V8.
NEXT_PUBLIC_SUPABASE_URL=https://bgvgstpoypqbjnemqcqp.supabase.co
SUPABASE_DESTINATION_CATALOG_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-catalog-v8
SUPABASE_DESTINATION_STAYS_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-stays-v8
SUPABASE_MATCH_LEARNING_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/match-learning
SUPABASE_MATCH_TRAIN_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/train-v8-ranker

# Feed ingestion / admin operations only. Hotel inventory is downstream of destination ranking.
SUPABASE_INGEST_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/ingest-linkwise-travel
SUPABASE_CSV_IMPORT_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/import-travel-csv

# Shared server-to-edge secret. Never expose with NEXT_PUBLIC_.
SUPABASE_INGEST_SECRET=
CRON_SECRET=
ADMIN_SECRET=

# V8 guarantees:
# - Destination ranking does NOT use hotel supply, affiliate EPC, discount or merchant economics.
# - Raw user/system conversation text is not stored for learning.
# - Optional tripText is interpreted in-request and is not destination evidence.
# - Learning uses anonymous structured feature/outcome rows only.
# - Neural learned influence remains 0 until >=500 V8 labels and validation passes.
# - Stay feed validity overlap is NOT claimed as live room availability.
