NEXT_PUBLIC_SITE_URL=

# Transactional delivery of the user-requested personal PDF guide.
RESEND_API_KEY=
TRAVEL_GUIDE_FROM_EMAIL="Ελληνικός AI Travel Guru <guides@example.gr>"

# Open/self-hosted fallback models. These are fallback capacity, not the canonical source of travel facts.
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_FREE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:cheapest
SELF_HOSTED_AI_BASE_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_API_KEY=

# V24 quality-critical semantic formulation/evidence route.
# preferReasoner tasks use DeepSeek first, then the strong OpenAI reasoner, then open/self-hosted fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRIMARY_MODEL=deepseek-v4-pro
DEEPSEEK_COUNCIL_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true

OPENAI_API_KEY=
OPENAI_ESCALATION_ENABLED=true
OPENAI_REASONER_MODEL=gpt-5.1
OPENAI_VERIFY_MODEL=gpt-5-mini
OPENAI_COUNCIL_MODEL=gpt-5-mini

# Shared semantic-routing thresholds and request budgets.
LLM_DETERMINISTIC_CONFIDENCE_THRESHOLD=0.93
LLM_DEEPSEEK_RISK_THRESHOLD=0.68
LLM_DEEPSEEK_CONFIDENCE_THRESHOLD=0.55
LLM_OPENAI_RISK_THRESHOLD=0.90
FREE_LLM_MAX_OUTPUT_TOKENS=220
DEEPSEEK_MAX_OUTPUT_TOKENS=320
OPENAI_MAX_OUTPUT_TOKENS=320
FREE_LLM_TIMEOUT_MS=6500
DEEPSEEK_TIMEOUT_MS=9000
OPENAI_TIMEOUT_MS=9000
LLM_MAX_FREE_CALLS_PER_REQUEST=4
LLM_MAX_PAID_CALLS_PER_REQUEST=3
LLM_MAX_OPENAI_CALLS_PER_REQUEST=1
LLM_MAX_RESERVED_OUTPUT_TOKENS_PER_REQUEST=1600

# Optional development-only audit model. Not part of the public authoritative decision path.
AUDIT_AI_BASE_URL=
AUDIT_AI_MODEL=
AUDIT_AI_API_KEY=

# Weather evidence.
OPEN_METEO_API_KEY=

# Supabase data services.
NEXT_PUBLIC_SUPABASE_URL=https://bgvgstpoypqbjnemqcqp.supabase.co
SUPABASE_DESTINATION_CATALOG_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-catalog-v8
SUPABASE_DESTINATION_STAYS_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-stays-v8
SUPABASE_STAY_CITIES_V15_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/stay-cities-v15
SUPABASE_DESTINATION_EVIDENCE_V12_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-evidence-v12
SUPABASE_MATCH_LEARNING_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/match-learning
SUPABASE_MATCH_TRAIN_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/train-v8-ranker

# V24 first-class locality reads. Both Edge endpoints require x-app-secret server-side.
SUPABASE_LOCALITY_PROFILES_V23_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/locality-profiles-v23
SUPABASE_LOCALITY_STAYS_V24_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/locality-stays-v24

# Feed ingestion / admin operations only.
SUPABASE_INGEST_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/ingest-linkwise-travel
SUPABASE_CSV_IMPORT_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/import-travel-csv

# Shared server-to-edge secret. Never expose with NEXT_PUBLIC_.
SUPABASE_INGEST_SECRET=
CRON_SECRET=
ADMIN_SECRET=
ENABLE_ADMIN_DASHBOARD=false

# V24 invariants:
# - Free text + structured fields become one 24D fuzzy semantic contract.
# - The formulator never names or ranks destinations/hotels.
# - Dated locality identity is first-class; canonical parent is optional enrichment.
# - Property/offer counts never increase locality/destination relevance.
# - Grounded locality evidence reranks before shortlist freeze.
# - Exact-locality hotel lookup uses locality_id through the protected Edge endpoint.
# - Hard accommodation requirements fail closed when matching evidence is absent.
# - Raw user/system conversation text is not stored for learning.
# - Cross-session personalization / learned ranking is disabled until consent, data-volume and calibration gates pass.
# - Feed validity overlap is NOT claimed as live room availability.
