NEXT_PUBLIC_SITE_URL=

# DeepSeek — primary reasoning provider. Server only.
# Used only for ambiguous final tie-breaks and selected-destination source synthesis.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

# OpenAI — OPTIONAL low-cost verifier only.
# It is NOT used for destination discovery, weather, semantic search or destination research.
# If unset, verification safely skips and the semantic/neural result remains valid.
OPENAI_API_KEY=
OPENAI_VERIFY_MODEL=gpt-5.4-nano

# Weather:
# - Long-range suitability uses NASA POWER climatology (no LLM cost).
# - Optional commercial Open-Meteo key enables short-range forecasts.
OPEN_METEO_API_KEY=

# Supabase AI DB + exact-date affiliate universe.
NEXT_PUBLIC_SUPABASE_URL=https://bgvgstpoypqbjnemqcqp.supabase.co
SUPABASE_AFFILIATE_TRAVEL_DATA_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/affiliate-travel-data
SUPABASE_AFFILIATE_DESTINATION_DETAIL_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/affiliate-destination-detail
SUPABASE_SEMANTIC_MATCH_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/semantic-match-data
SUPABASE_MATCH_LEARNING_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/match-learning
SUPABASE_MATCH_TRAIN_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/train-semantic-ranker

# Existing admin / ingestion functions retained for operations.
SUPABASE_DECISION_DATA_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/travel-decision-data
SUPABASE_STAY_DATA_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/travel-stay-data
SUPABASE_INGEST_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/ingest-linkwise-travel
SUPABASE_CSV_IMPORT_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/import-travel-csv

# Shared server-to-edge secret. Never expose to browser/NEXT_PUBLIC_.
SUPABASE_INGEST_SECRET=
CRON_SECRET=
ADMIN_SECRET=

# Privacy / matching notes:
# - Raw chat/system/user text is not stored for matching.
# - Matching stores normalized anonymous travel features + outcome labels only.
# - Learned neural weight stays at zero until at least 500 real labeled outcomes.
# - Consumer choices require exact-date Linkwise inventory and deterministic weather/season checks.
