NEXT_PUBLIC_SITE_URL=

# Open-source map tiles. Keep attribution visible. The default OSM tile endpoint is suitable
# for normal interactive viewing; switch this env to another OSM-derived/self-hosted provider
# if traffic grows or your usage pattern requires a different service.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Transactional delivery of the user-requested personal PDF guide.
# Verify the sender domain before enabling this in production.
RESEND_API_KEY=
TRAVEL_GUIDE_FROM_EMAIL="Ελληνικός AI Travel Guru <guides@example.gr>"

# V25/V30 live Tripadvisor content. Rankings/ratings are used only when returned by the API.
TRIPADVISOR_API_KEY=
TRIPADVISOR_REFERER=

BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.2

CANVA_TRAVEL_GUIDE_TEMPLATE_ID=

HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_FREE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:cheapest

SELF_HOSTED_AI_BASE_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_API_KEY=

DEEPSEEK_API_KEY=
