NEXT_PUBLIC_SITE_URL=

# Open-source map tiles. Keep attribution visible. The default OSM tile endpoint is suitable
# for normal interactive viewing; switch this env to another OSM-derived/self-hosted provider
# if traffic grows or your usage pattern requires a different service.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Transactional delivery of the user-requested personal PDF guide.
# Verify the sender domain before enabling this in production.
RESEND_API_KEY=
TRAVEL_GUIDE_FROM_EMAIL="Ελληνικός AI Travel Guru <guides@example.gr>"

# V25/V30 live Tripadvisor content. Rankings/ratings are used only when returned by the API.
TRIPADVISOR_API_KEY=
# Set to the final production origin after deployment, e.g. https://travelaigreece.vercel.app
TRIPADVISOR_REFERER=

# V30 Booking.com Demand API (optional). Both values are required. If they are absent,
# Booking.com is marked not-configured and contributes zero invented data to the AI map.
BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.2

# Optional Canva brand-template ID once Canva Brand Template/Autofill access is enabled.
# The app works without it and renders a Canva-ready/printable live guide.
CANVA_TRAVEL_GUIDE_TEMPLATE_ID=

# V16 FREE / OPEN MODEL TIER — first semantic escalation after deterministic parsing.
# Hugging Face exposes an OpenAI-compatible inference-router API. Use a token only in server env.
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_FREE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:cheapest

# Optional self-hosted OpenAI-compatible model (vLLM / llama.cpp etc.).
# When configured it is attempted before Hugging Face.
SELF_HOSTED_AI_BASE_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_API_KEY=

# DeepSeek — second semantic tier for high-risk/ambiguous cases only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_COUNCIL_MODEL=deepseek-v4-flash
DEEPSEEK_INTENT_MODEL=deepseek-v4-flash
DEEPSEEK_RESEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high

# OpenAI — final escalation only for the highest-risk contradictory cases.
OPENAI_API_KEY=
OPENAI_ESCALATION_ENABLED=true
OPENAI_VERIFY_MODEL=gpt-5.4-nano
OPENAI_COUNCIL_MODEL=gpt-5.4-nano

# V16 semantic-routing thresholds. All stages share one request budget.
LLM_DETERMINISTIC_CONFIDENCE_THRESHOLD=0.93
LLM_DEEPSEEK_RISK_THRESHOLD=0.68
LLM_OPENAI_RISK_THRESHOLD=0.90
FREE_LLM_MAX_OUTPUT_TOKENS=180
DEEPSEEK_MAX_OUTPUT_TOKENS=240
OPENAI_MAX_OUTPUT_TOKENS=180
FREE_LLM_TIMEOUT_MS=6500
DEEPSEEK_TIMEOUT_MS=6500
OPENAI_TIMEOUT_MS=5000
LLM_MAX_FREE_CALLS_PER_REQUEST=4
LLM_MAX_PAID_CALLS_PER_REQUEST=2
LLM_MAX_OPENAI_CALLS_PER_REQUEST=1
LLM_MAX_RESERVED_OUTPUT_TOKENS_PER_REQUEST=1000

# Optional development-only audit model. Not part of the public request path.
AUDIT_AI_BASE_URL=
AUDIT_AI_MODEL=
AUDIT_AI_API_KEY=

# Weather evidence:
# Long-range: NASA POWER climatology, no LLM/token cost.
# V25 daily short-range weather uses Open-Meteo's forecast API and falls back to
# climatology outside the reliable forecast horizon. Existing commercial key remains optional.
OPEN_METEO_API_KEY=

# Supabase Destination Knowledge V8 / V16 inventory grounding.
NEXT_PUBLIC_SUPABASE_URL=https://bgvgstpoypqbjnemqcqp.supabase.co
SUPABASE_DESTINATION_CATALOG_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-catalog-v8
SUPABASE_DESTINATION_STAYS_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-stays-v8
SUPABASE_STAY_CITIES_V15_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/stay-cities-v15
SUPABASE_DESTINATION_EVIDENCE_V12_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-evidence-v12
SUPABASE_MATCH_LEARNING_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/match-learning
SUPABASE_MATCH_TRAIN_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/train-v8-ranker

# Feed ingestion / admin operations only. Hotel inventory is downstream of destination ranking.
SUPABASE_INGEST_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/ingest-linkwise-travel
SUPABASE_CSV_IMPORT_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/import-travel-csv

# Shared server-to-edge secret. Never expose with NEXT_PUBLIC_.
SUPABASE_INGEST_SECRET=
CRON_SECRET=
ADMIN_SECRET=
ENABLE_ADMIN_DASHBOARD=false

# V16/V25/V30 guarantees:
# - Deterministic logic is always first and costs zero model tokens.
# - A free/open model is attempted before paid providers when semantic escalation is needed.
# - DeepSeek and OpenAI are bounded by explicit confidence/risk and per-request call/token ceilings.
# - All runtime agents share the same request budget; no hidden independent paid fallback is allowed.
# - Hard accommodation language such as “κατάλυμα μπροστά στη θάλασσα μόνο” is an eligibility gate.
# - A selected destination or explicit destination phrase is a geography scope, not a score bonus.
# - A model may classify the request but cannot manufacture property or review evidence.
# - Destination ranking does NOT use affiliate EPC, commission or merchant economics.
# - Raw user/system conversation text is not stored for learning.
# - Stay feed validity overlap is NOT claimed as live room availability.
# - Flexible-date proposals preserve the original check-in/check-out weekday pattern.
# - Tripadvisor/Booking ratings are shown only from live API responses; missing data is not estimated.
