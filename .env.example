NEXT_PUBLIC_SITE_URL=

# Open-source map tiles. Keep attribution visible. The default OSM tile endpoint is suitable
# for normal interactive viewing; switch this env to another OSM-derived/self-hosted provider
# if traffic grows or your usage pattern requires a different service.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Transactional delivery of the user-requested personal PDF guide.
# Verify the sender domain before enabling this in production.
RESEND_API_KEY=
TRAVEL_GUIDE_FROM_EMAIL="Ελληνικός AI Travel Guru <guides@example.gr>"

# V25/V30 live Tripadvisor content. Rankings/ratings are used only when returned by the API.
TRIPADVISOR_API_KEY=
TRIPADVISOR_REFERER=

# V30 Booking.com Demand API (optional). Both values are required.
BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.2

# Optional Canva brand-template ID.
CANVA_TRAVEL_GUIDE_TEMPLATE_ID=

# V44 FREE LLM TIER — FIRST semantic escalation after deterministic parsing.
# OpenRouter Free Models Router automatically selects a currently free model that satisfies
# capabilities requested by the call (e.g. tool use / structured outputs when available).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=openrouter/free

# Additional free/open fallbacks after OpenRouter.
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_FREE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:cheapest
SELF_HOSTED_AI_BASE_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_API_KEY=

# DeepSeek — paid reasoning tier after free/open models for ambiguous, high-risk or verification work.
# Current DeepSeek API model IDs as of 2026-09: deepseek-flash (V4.1 Flash) and deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRIMARY_MODEL=deepseek-v4-pro
DEEPSEEK_COUNCIL_MODEL=deepseek-flash
DEEPSEEK_INTENT_MODEL=deepseek-flash
DEEPSEEK_RESEARCH_MODEL=deepseek-flash
DEEPSEEK_VERIFY_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# OpenAI — disabled by default. Optional emergency escalation only when explicitly enabled.
OPENAI_API_KEY=
OPENAI_ESCALATION_ENABLED=false
OPENAI_VERIFY_MODEL=gpt-5.4-nano
OPENAI_COUNCIL_MODEL=gpt-5.4-nano

# V44 semantic-routing thresholds and one shared request budget for ALL runtime agents.
LLM_DETERMINISTIC_CONFIDENCE_THRESHOLD=0.93
LLM_DEEPSEEK_RISK_THRESHOLD=0.58
LLM_DEEPSEEK_CONFIDENCE_THRESHOLD=0.62
LLM_OPENAI_RISK_THRESHOLD=0.97
FREE_LLM_MAX_OUTPUT_TOKENS=260
DEEPSEEK_MAX_OUTPUT_TOKENS=420
OPENAI_MAX_OUTPUT_TOKENS=180
FREE_LLM_TIMEOUT_MS=7500
DEEPSEEK_TIMEOUT_MS=10000
OPENAI_TIMEOUT_MS=6000
LLM_MAX_FREE_CALLS_PER_REQUEST=6
LLM_MAX_PAID_CALLS_PER_REQUEST=3
LLM_MAX_OPENAI_CALLS_PER_REQUEST=0
LLM_MAX_RESERVED_OUTPUT_TOKENS_PER_REQUEST=1800

# Optional development-only audit model. Not part of the public request path.
AUDIT_AI_BASE_URL=
AUDIT_AI_MODEL=
AUDIT_AI_API_KEY=

# Weather evidence.
OPEN_METEO_API_KEY=

# Supabase Destination Knowledge / Travel Intelligence Fabric.
NEXT_PUBLIC_SUPABASE_URL=https://bgvgstpoypqbjnemqcqp.supabase.co
SUPABASE_DESTINATION_CATALOG_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-catalog-v8
SUPABASE_DESTINATION_STAYS_V8_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-stays-v8
SUPABASE_STAY_CITIES_V15_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/stay-cities-v15
SUPABASE_DESTINATION_EVIDENCE_V12_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/destination-evidence-v12
SUPABASE_MATCH_LEARNING_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/match-learning
SUPABASE_MATCH_TRAIN_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/train-v8-ranker
SUPABASE_TRAVEL_INTELLIGENCE_V44_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/travel-intelligence-v44

# Feed ingestion / admin operations only. Hotel inventory is downstream of destination ranking.
SUPABASE_INGEST_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/ingest-linkwise-travel
SUPABASE_CSV_IMPORT_URL=https://bgvgstpoypqbjnemqcqp.supabase.co/functions/v1/import-travel-csv

# Shared server-to-edge secret. Never expose with NEXT_PUBLIC_.
SUPABASE_INGEST_SECRET=
CRON_SECRET=
ADMIN_SECRET=
ENABLE_ADMIN_DASHBOARD=false

# V44 guarantees:
# - Deterministic logic is always first and costs zero model tokens.
# - OpenRouter openrouter/free is the first external semantic model route when OPENROUTER_API_KEY exists.
# - Self-hosted/Hugging Face remain additional free/open fallbacks.
# - DeepSeek Flash handles ambiguous/agent reasoning; DeepSeek V4 Pro is reserved for verification/high-risk reasoning.
# - OpenAI is OFF by default and is not needed for normal runtime operation.
# - All runtime agents share one request budget; no hidden independent paid fallback is allowed.
# - Hard constraints remain deterministic eligibility gates.
# - Models may classify/reason but cannot manufacture property, availability, price, rating, route or evidence facts.
# - Destination ranking never uses affiliate EPC/commission/merchant economics.
# - Raw user/system conversation text is not stored for learning.
